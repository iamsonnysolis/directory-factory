# Directory Factory — credentials
# Copy to .env and fill in real values. This file is git-ignored.

# --- Google Places API ---
GOOGLE_PLACES_API_KEY=

# --- Google Gemini API ---
GEMINI_API_KEY=

# --- Cloudflare ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Cloudflare D1 ---
# Auto-created by the upload script on first run.
# Get manually: https://dash.cloudflare.com -> D1 -> your database
D1_DATABASE_ID=

# --- GitHub ---
GITHUB_TOKEN=