# Directory Factory — credentials
# Copy to .env and fill in real values. This file is git-ignored.

# --- Google Places API ---
GOOGLE_PLACES_API_KEY=

# --- Google Gemini API ---
GEMINI_API_KEY=

# --- Cloudflare ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- GitHub ---
GITHUB_TOKEN=

# --- Cloudflare D1 (set at runtime per directory, not here) ---
# D1 credentials are passed per-project as params to the upload/deploy scripts.
